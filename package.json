{
  "name": "game-guess",
  "version": "0.1.0",
  "private": true,
  "description": "Lắt Léo — game đố mẹo hack não kiểu Việt.",
  "engines": {
    "node": ">=22.22.3 <23"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check . \"!docs/**\" \"!**/*.md\"",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run lint && npm run format:check && npm run typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "levels:generate": "node scripts/generate-levels.mjs",
    "predev": "npm run levels:generate",
    "prebuild": "npm run levels:generate",
    "pretest": "npm run levels:generate",
    "pretypecheck": "npm run levels:generate",
    "test:examples": "node scripts/test-engine-examples.mjs"
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.182.0",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.182.0",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.6",
    "jsdom": "31.0.0",
    "prettier": "3.10.0",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
