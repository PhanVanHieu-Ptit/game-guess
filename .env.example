# Sao chép thành `.env.local` rồi chỉnh. Mọi biến ở đây đều công khai (NEXT_PUBLIC_*), KHÔNG đặt bí mật vào đây.

# Mở khóa mọi màn để thử và kiểm thử (không hiện trong giao diện). Đặt 1 để mở hết; bỏ trống = mở tuần tự.
NEXT_PUBLIC_UNLOCK_ALL=

# Nơi ghi sự kiện đo lường (docs/TECH.md mục 9.1).
#   console = in ra console trình duyệt (mặc định khi chạy `npm run dev`; dùng cho E2E)
#   off     = không ghi (mặc định khi build production)
NEXT_PUBLIC_ANALYTICS=

# Thời gian tối đa chờ nạp cảnh của một màn (mili giây) trước khi hiện "Thử lại". Bỏ trống = 20000.
# Giới hạn thời gian khi yêu cầu tải gói JS bị treo (xem src/features/config.ts).
NEXT_PUBLIC_SCENE_TIMEOUT_MS=
